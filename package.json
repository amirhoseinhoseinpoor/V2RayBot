{
  "type": "module",
  "private": true,
  "prisma": {
    "seed": "ts-node prisma/seed.ts"
  },
  "scripts": {
    "dev": "npx tsx watch --env-file .env src/index.ts",
    "prisma:generate": "prisma generate --schema=./prisma/schema.prisma",
    "prisma:migrate": "prisma migrate deploy --schema=./prisma/schema.prisma",
    "prisma:seed": "ts-node --esm prisma/seed.ts",
    "start": "node dist/bot.js",
    "lint": "npx eslint",
    "lint:fix": "npm run lint --fix",
    "prepare": "husky",
    "build": "rimraf dist && tsc"
  },
  "dependencies": {
    "@gramio/auto-answer-callback-query": "^0.0.2",
    "@gramio/auto-retry": "^0.0.3",
    "@gramio/media-cache": "^0.0.4",
    "@gramio/pagination": "^0.0.2",
    "@gramio/scenes": "^0.3.0",
    "@gramio/session": "^0.1.6",
    "@gramio/storage-redis": "^1.0.4",
    "@prisma/client": "^6.12.0",
    "@types/dotenv": "^6.1.1",
    "@typescript-eslint/eslint-plugin": "^8.38.0",
    "@typescript-eslint/parser": "^8.38.0",
    "@verrou/core": "^0.5.1",
    "dotenv": "^17.2.1",
    "env-var": "^7.5.0",
    "eslint-plugin-security": "^3.0.1",
    "fastify": "^5.4.0",
    "gramio": "^0.4.10",
    "ioredis": "^5.6.1",
    "jobify": "^0.1.6"
  },
  "devDependencies": {
    "@antfu/eslint-config": "^4.17.0",
    "@types/node": "^24.0.14",
    "eslint": "^9.31.0",
    "husky": "^9.1.7",
    "nodemon": "^3.1.10",
    "prisma": "^6.12.0",
    "rimraf": "^6.0.1",
    "ts-node": "^10.9.2",
    "tsx": "^4.20.3",
    "typescript": "^5.8.3"
  }
}

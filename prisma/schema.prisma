generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                     Int       @id @default(autoincrement())
  telegramId             BigInt    @unique
  referredBy             Int? // ID of referrer                                         new
  referralCounted        Boolean   @default(false)                                      //new
  referralCount          Int       @default(0) // total successful referrals           //new
  referralRewardsClaimed Int       @default(0) // how many free VPNs already claimed   new
  username               String?
  firstName              String?
  freeAccount            Boolean   @default(false)
  createdAt              DateTime  @default(now())
  Payment                Payment[]
  vpns                   VPN[]
}

model Plan {
  id          Int       @id @default(autoincrement())
  name        String
  description String
  duration    Int
  trafficGB   Int
  price       Float
  Payment     Payment[]
  vpns        VPN[]
}

model Payment {
  id        Int      @id @default(autoincrement())
  userId    Int
  planId    Int
  amount    Float
  receipt   String
  status    String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  plan      Plan     @relation(fields: [planId], references: [id])
  user      User     @relation(fields: [userId], references: [id])
}

model VPN {
  id            Int       @id @default(autoincrement())
  userId        Int
  email         String    @unique
  uuid          String
  trafficNotify Boolean   @default(false)
  timeNotify    Boolean   @default(false)
  alterId       Int       @default(0)
  createdAt     DateTime  @default(now())
  type          VPNType
  expired       Boolean   @default(false)
  trafficLimit  BigInt    @default(0)
  savedDays     Int       @default(0)
  savedPlanId   Int       @default(0)
  savedTraffic  BigInt    @default(0)
  planId        Int?
  expiredAt     DateTime? @db.Timestamp(6)
  trafficLogs   Traffic[]
  plan          Plan?     @relation(fields: [planId], references: [id])
  user          User      @relation(fields: [userId], references: [id])
}

model Traffic {
  id        Int      @id @default(autoincrement())
  vpnId     Int      @unique
  uplink    BigInt   @default(0)
  downlink  BigInt   @default(0)
  timestamp DateTime @default(now())
  vpn       VPN      @relation(fields: [vpnId], references: [id])
}

enum VPNType {
  free
  paid
}
